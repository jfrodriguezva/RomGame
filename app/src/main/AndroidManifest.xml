<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RominaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MiAmbiente"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MiAmbiente"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <!--
                Bug real reportado: "todo esta en una sola vista, eso debe
                aplicarse para telefonos". Antes `screenOrientation="portrait"`
                bloqueaba cualquier giro sin importar el sensor del
                dispositivo. Se quito para que gire libre (tablet y
                celular), y se declara `configChanges` para que Android NO
                destruya y recree la Activity al girar, ni al cambiar el
                modo oscuro, el tamano de letra o el idioma — sin esto, cada
                `remember { mutableStateOf(...) }` de cada material (la
                partida de domino a medias, el dibujo de la pizarra) se
                perderia con cada cambio.
            -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compartir dibujos de la pizarra por Intent nativo (content://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
